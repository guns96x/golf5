  /begin MOD_COMMON ""
    BYTE_ORDER MSB_FIRST
    ALIGNMENT_BYTE 1
    ALIGNMENT_WORD 2
    ALIGNMENT_LONG 4
    ALIGNMENT_FLOAT32_IEEE 4
  /end MOD_COMMON

    /begin IF_DATA ASAP1B_Bypass 
		/begin TP_BLOB 
		  0x100		/* Bypass version */ 
		  0x100		/* Blob version */ 
		/end TP_BLOB 
    /end IF_DATA 
	
  /begin IF_DATA ASAP1B_CCP
      /begin SOURCE
	      "segment synchronous event channel"
		  103
		  1
		  /begin QP_BLOB
		      0
			  LENGTH 8
			  CAN_ID_FIXED 0x7C7
			  FIRST_PID 0
			  RASTER 0
		  /end QP_BLOB
	  /end SOURCE
  
      /begin SOURCE
	      "10ms time synchronous event channel"
		  4
		  1
		  /begin QP_BLOB
		      1
			  LENGTH 12
			  CAN_ID_FIXED 0x7C5
			  FIRST_PID 8
			  RASTER 1
		  /end QP_BLOB
	  /end SOURCE
  
      /begin SOURCE
	      "100ms time synchronous event channel"
		  4
		  10
		  /begin QP_BLOB
		      2
			  LENGTH 4
			  CAN_ID_FIXED 0x7C6
			  FIRST_PID 20
			  RASTER 2
		  /end QP_BLOB
	  /end SOURCE
  
      /begin RASTER
	      "segment synchronous event channel"
	      "seg_sync"
		  0
		  103
		  1
	  /end RASTER
  
      /begin RASTER
	      "10ms time synchronous event channel"
	      "10_ms"
		  1
		  4
		  1
	  /end RASTER
  
      /begin RASTER
	      "100ms time synchronous event channel"
	      "100_ms"
		  2
		  4
		  10
	  /end RASTER
  
	  /begin SEED_KEY
	      /* seed&key dll for CAL privilege */ ""
	      /* seed&key dll for DAQ privilege */ ""
	      /* seed&key dll for PGM privilege */ ""
	  /end SEED_KEY
  
	  /begin TP_BLOB
	      /* CCP version       */ 0x201
		  /* Blob version      */ 0x202
		  /* CAN msg ID - send */ 0x7C3
		  /* CAN msg ID - recv */ 0x7C4
		  /* station address   */ 0x1234
		  /* byte order        */ 1
          
		  /begin CAN_PARAM
		      /* crystal frequency */ 0x1F4
			  /* timing register 0 */ 0x41
			  /* timing register 1 */ 0x14
		  /end CAN_PARAM
          
		  DAQ_MODE    BURST
		  CONSISTENCY DAQ
          
		  /begin CHECKSUM_PARAM 
		      /* algorithm */ 0xC001
		      /* limit     */ 0xFFFFFFFF
		      CHECKSUM_CALCULATION ACTIVE_PAGE
          /end CHECKSUM_PARAM 
          
		  /begin DEFINED_PAGES
		      1
			  "reference page"
			  /* address ext. */ 0x00
			  /* base address */ 0x1C1C54
			  /* page length  */ 0x317C4
			  ROM
		  /end DEFINED_PAGES
          
		  /begin DEFINED_PAGES
		      2
			  "working page"
			  /* address ext. */ 0x00
			  /* base address */ 0x801C1C54
			  /* page length  */ 0x317C4
			  RAM
			  RAM_INIT_BY_ECU
		  /end DEFINED_PAGES
          
		  OPTIONAL_CMD 0x11  /* SELECT_CAL_PAGE */
		  OPTIONAL_CMD 0xE  /* BUILD_CHKSUM */
		  OPTIONAL_CMD 0x19  /* MOVE */
		  OPTIONAL_CMD 0x9  /* GET_ACTIVE_CAL_PAGE */
		  OPTIONAL_CMD 0xC  /* SET_S_STATUS */
		  OPTIONAL_CMD 0xD  /* GET_S_STATUS */
		  OPTIONAL_CMD 0x12  /* GET_SEED */
		  OPTIONAL_CMD 0x13  /* UNLOCK */
	  /end TP_BLOB
  /end IF_DATA

  /begin IF_DATA ETK 
      /begin SOURCE 
          "segment synchronous raster" 
          103 
          1 
          QP_BLOB 
            1 
            /* MAXNUM_A  */ 200 
            /* DISTAB_A  */ 0x11C0188 
            /* CHNL_A    */ 0x9FE0DC 
            /* TRG_ID_A  */ 0x9FE088 
            /* TrgRate   */ 0 
            /* MaxBypTab */ 0 
            /* AdrBypTab */ 0x0 
      /end SOURCE 
  
      /begin SOURCE 
          "10ms time synchronous raster" 
          4 
          1 
          QP_BLOB 
            2 
            /* MAXNUM_B  */ 200 
            /* DISTAB_B  */ 0x11C04B0 
            /* CHNL_B    */ 0x9FE1A4 
            /* TRG_ID_B  */ 0x9FE08C 
            /* TrgRate   */ 20 
            /* MaxBypTab */ 0 
            /* AdrBypTab */ 0x0 
      /end SOURCE 
  
      /begin SOURCE 
          "100ms time synchronous raster" 
          5 
          1 
          QP_BLOB 
            3 
            /* MAXNUM_C  */ 100 
            /* DISTAB_C  */ 0x11C07D8 
            /* CHNL_C    */ 0x9FE26C 
            /* TRG_ID_C  */ 0x9FE090 
            /* RepRate   */ 100 
            /* MaxBypTab */ 0 
            /* AdrBypTab */ 0x0 
      /end SOURCE 
  
      /begin SOURCE 
          "bypass segment sync. raster" 
          103 
          1 
          QP_BLOB 
            4 
            /* BPMAX_S   */ 28 
            /* BYPASS_S  */ 0x11C0058 
            /* CHNL_S    */ 0x9FE094 
            /* TRGID_S   */ 0x9FE080 
            /* RepRate   */ 0 
            /* BPMAX_T   */ 28 
            /* CHNL_T    */ 0x11C0970 
      /end SOURCE 
  
      /begin SOURCE 
          "bypass 10ms time sync. raster" 
          4 
          1 
          QP_BLOB 
            5 
            /* BPMAX_X   */ 44 
            /* BYPASS_X  */ 0x11C00D0 
            /* CHNL_X    */ 0x9FE0B0 
            /* TRGID_X   */ 0x9FE084 
            /* RepRate   */ 20 
            /* BPMAX_Y   */ 44 
            /* CHNL_Y    */ 0x11C09B0 
      /end SOURCE 
  
      /begin TP_BLOB 
		  /* Blob version */ 0x1000001 
          /* PBA          */ 0x0 
          /* RESET_CFG    */ 0x800 
      
	      /begin DISTAB_CFG 
              /* DSPTAB   */ 13 
              /* DAT_MOD  */ 1 
              /* RFG      */ 1 
              /* TRGSEGAD */ 0x9FE000 
			  /* TRG_CFG  */ 0x1010100 
              TRG_MOD 0 255 
		  /end DISTAB_CFG 
      
          CODE_CHK 
            /* ChkSumData   */ 0x11FDF74 
            /* PrgDataLen   */ 0x4 
            /* ChkSumExtRam */ 0x9FFFF8 
            /* PrgExtRamLen */ 0x4 
      
          ETK_CFG 
            0x03 0xD2 0x4D 0xFF 0xEF 0x4E 0xDF 0xEF 0x4E 0xFF 0xFB 0xFE 0xFF 0xFF 0xFE 0xFF 0xFF 0xF0 0x0F 0xFF 0x03 0xCD 0xFF 0xFF 
      
          RESERVED 
            0x11C0058 
            0xAE0 
            EXTERN -1 -1 -1 -1 -1 
      
      /end TP_BLOB 
  /end IF_DATA 

  /begin IF_DATA ASAP1B_KWP2000 
      /begin SOURCE 
	      "timeslot" 
		  4 
		  1 
		  QP_BLOB 
		      0 
			  BLOCKMODE 
			  0xF0 
			  0 
              20 
	  /end SOURCE 
  
	  /begin TP_BLOB 
		  /* Blob version          */ 0x101 
		  /* ECU address on k line */ 0x10 
		  /* requ. tester address  */ 0xF1 
		  /* ECU stimulation mode  */ WuP 
		  /* byte order            */ MSB_FIRST 
          /* ...                   */ 1 
          
		  DATA_ACCESS 
			  /* Flash address */ 0x000000 
			  /* RAM address   */ 0x000000 
              /* Data Read   */ 1 
              /* Code Verify */ 0 
              /* Code Read   */ 0 
              /* Load mode   */ 1 
          
		  /begin CHECKSUM 
              0x010201 
              1 
              1 
              RequestRoutineResults 
              RNC_RESULT 0x23 
          /end CHECKSUM 
          
          /begin FLASH_COPY 
              NOFLASHBACK 
              3 
              RequestRoutineResults 
              RAM_InitByECU 
              0x86 
              COPY_FRAME 1 
              RNC_RESULT 0x23 0xFB 0xFC 
          /end FLASH_COPY 
          
          /begin DIAG_BAUD 
              /* BaudRate */ 38400 
              /* DiagMode */ 0x86 
              BD_PARA 0x50 
          /end DIAG_BAUD 
		  
          /begin DIAG_BAUD 
              /* BaudRate */ 10400 
              /* DiagMode */ 0x86 
              BD_PARA 0x14 
          /end DIAG_BAUD 
		  
          /begin DIAG_BAUD 
              /* BaudRate */ 57600 
              /* DiagMode */ 0x86 
              BD_PARA 0x64 
          /end DIAG_BAUD 
		  
          /begin DIAG_BAUD 
              /* BaudRate */ 125000 
              /* DiagMode */ 0x86 
              BD_PARA 0x87 
          /end DIAG_BAUD 
          
		  /* Timing Parameter: p1Max  p2Min  p2Max  p3Min  p3Max  p4Min */ 
          TIME_DEF             0x0014 0x0000 0x0032 0x0003 0x0200 0x0000 
          TIME_DEF             0x0014 0x0000 0x0032 0x0003 0x0200 0x0001 
          TIME_DEF             20     0      2000   0      5000   65440  
		  
		  /* Seed&Key Parameter: AccMode  CalcMethod  Delay */ 
		   SECURITY_ACCESS        3          1        0    
                   SECURITY_ACCESS        9          1        0    
          
		  /begin PAGE_SWITCH 
		      ESCAPE_CODE 
			  ESCAPE_CODE_PARA 0x90 
			  PAGE_CODE 0x00 0x01 
		  /end PAGE_SWITCH 
		  
	  /end TP_BLOB 
  /end IF_DATA 

    /begin IF_DATA ASAP1B_MCMESS 
        /begin SOURCE 
		  "segment synchronous raster" 
		  103 1 
		  QP_BLOB 
		    ANGLE 
			20		/* max. number of bytes (BLKZ_W) */ 
		/end SOURCE 
		
        /begin SOURCE 
		  "10ms time synchronous raster" 
		  103 1 
		  QP_BLOB 
		    TIME 
			20		/* max. number of bytes (BLKZ_Z) */ 
		/end SOURCE 
		
        /begin SOURCE 
		  "handshake" 
		  103 1 
		  QP_BLOB 
		    HANDSHAKE 
			20		/* max. number of bytes: 0 */ 
		/end SOURCE 
		
		/begin TP_BLOB 
		  0x101		/* Blob version */ 
		  KOMKEN 11		/* communication identifier */ 
		  MCTGT  0x10	/* target address */ 
		  MCINI  KW2000	/* wake up method */ 
          
		  /begin CHECKSUM_PARAM 
		    /* type qualifier */ 0x8001 
			CHECKSUM_CALCULATION ACTIVE_PAGE 
		  /end CHECKSUM_PARAM 
          
		  /begin DEFINED_PAGES 
		    1 
			"reference page" 
			FLASH 
			  NO_FLASH_BACK 
			  DEFAULT 
		  /end DEFINED_PAGES 
          
		  BYTE_ORDER MSB_FIRST 
		  THREE_BYTE_ADDRESSES 
		/end TP_BLOB 
    /end IF_DATA 
