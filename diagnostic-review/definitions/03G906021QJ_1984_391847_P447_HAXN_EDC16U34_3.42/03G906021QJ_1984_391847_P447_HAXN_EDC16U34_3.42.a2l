    "Meßpunkt für Abschaltung des NSC-Temperaturmodells bei fehlerhaften Eingangsgrößen"
    UBYTE
    OneToOne
    1
    100
    0.00
    255.0

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x9FFCE4
    /begin IF_DATA ASAP1B_CCP
	    KP_BLOB
		  0x00
		  0x9FFCE4
		  0x1
    /end IF_DATA
    /begin IF_DATA ETK 
	    KP_BLOB 
		  0x9FFCE4 
          1 
		  0x1 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_KWP2000 
	    KP_BLOB 
		  0x9FFCE4 
          EXTERN 
		  0x1 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_MCMESS 
	    /begin KP_BLOB 
		  0x9FFCE4 
          EXTERN 
		  0x1 
	    /end KP_BLOB 
    /end IF_DATA 

/end MEASUREMENT

