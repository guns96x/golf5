    100
    0.00
    255.0

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x7F9379
    /begin IF_DATA ASAP1B_CCP
	    KP_BLOB
		  0x00
		  0x7F9379
		  0x1
    /end IF_DATA
    /begin IF_DATA ETK 
	    KP_BLOB 
		  0x7F9379 
          0 
		  0x1 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_KWP2000 
	    KP_BLOB 
		  0x7F9379 
          INTERN 
		  0x1 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_MCMESS 
	    /begin KP_BLOB 
		  0x7F9379 
          INTERN 
		  0x1 
	    /end KP_BLOB 
    /end IF_DATA 

/end MEASUREMENT

