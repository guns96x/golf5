    "FID Bremse 8 - Botschaftszähler, Checksumme, Timeout-Fehler"
    UBYTE
    OneToOne
    1
    100
    0.00
    255.0

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x9FFD8E
    /begin IF_DATA ASAP1B_CCP
	    KP_BLOB
		  0x00
		  0x9FFD8E
		  0x1
    /end IF_DATA
    /begin IF_DATA ETK 
	    KP_BLOB 
		  0x9FFD8E 
          1 
		  0x1 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_KWP2000 
	    KP_BLOB 
		  0x9FFD8E 
          EXTERN 
		  0x1 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_MCMESS 
	    /begin KP_BLOB 
		  0x9FFD8E 
          EXTERN 
		  0x1 
	    /end KP_BLOB 
    /end IF_DATA 

/end MEASUREMENT

